# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/server_template

# JWT (production: provide a unique secret of at least 32 bytes)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Administrators (comma-separated user IDs)
ADMIN_USER_IDS=

# Log
LOG_LEVEL=debug

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60
