# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/server_template

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Log
LOG_LEVEL=debug

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# AI Agent
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_BASE_URL=https://xxx.xxx.com
