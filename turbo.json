{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "format": {},
    "typecheck": {},
    "test": {
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "generate:api": {
      "cache": false
    }
  }
}
